# Copy to .env for local development, or set these in your hosting environment.
# Every database value and both email settings are required; there are no
# built-in database credentials or email sender addresses.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional. Set only when the frontend is deployed on a different origin,
# for example https://grade-tracker.example.com. Leave blank when both
# repositories are served from the same origin.
APP_ALLOWED_ORIGIN=